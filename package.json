{
  "name": "release-lens",
  "version": "0.1.0",
  "description": "Risk-based QA intelligence for every pull request.",
  "keywords": [
    "qa",
    "testing",
    "release-risk",
    "code-review",
    "git-diff",
    "quality-assurance",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "release-lens": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/bin.js",
    "dev": "tsx src/cli/bin.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/config tests/risk tests/recommendations tests/signals",
    "test:integration": "vitest run tests/integration",
    "test:cli": "vitest run tests/cli",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "minimatch": "^10.0.1",
    "parse-diff": "^0.11.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^5.0.0"
  }
}
